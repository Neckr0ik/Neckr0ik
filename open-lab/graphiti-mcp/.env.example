# --- LLM + embeddings + reranker: Gemini (aistudio.google.com -> Get API key) ---
GOOGLE_API_KEY=...
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview

# --- Opcional: Anthropic (hoy NO funciona en graphiti-core: envia `temperature`, que la API rechaza) ---
ANTHROPIC_API_KEY=
EMBEDDER_MODEL=gemini-embedding-001
EMBEDDER_DIMENSIONS=768

# --- Graphiti ---
GRAPHITI_GROUP_ID=main
SEMAPHORE_LIMIT=5
GRAPHITI_TELEMETRY_ENABLED=false
FALKORDB_DATABASE=default_db

# --- Visor FalkorDB Browser (http://localhost:3000) ---
# 1-instalar-graphiti.ps1 los genera solos si faltan. ENCRYPTION_KEY = 64 caracteres hexadecimales.
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# --- Acceso remoto ---
# Ruta secreta larga (setup.ps1 la genera sola). Es tu "contraseña": no la compartas.
MCP_SECRET_PATH=cambia-esto-por-algo-largo-y-aleatorio
# Elige UNA salida publica: tailscale (recomendado, sin dominio) o tunnel (Cloudflare, con dominio propio)
EXPOSE_MODE=tailscale

# Tailscale: login.tailscale.com -> Settings -> Keys -> Generate auth key (Reusable, sin Ephemeral)
TS_AUTHKEY=
TS_HOSTNAME=graphiti

# Cloudflare: Zero Trust -> Networks -> Tunnels -> Create -> Docker
CLOUDFLARE_TUNNEL_TOKEN=

# --- Health check (opcional, recomendado) ---
# URL publica de salud: https://<host-publico>/<MCP_SECRET_PATH>/health
#   Tailscale: https://graphiti.<tu-tailnet>.ts.net/...   Cloudflare: https://graphiti.tu-dominio.com/...
PUBLIC_HEALTH_URL=
# Crea un check gratis en https://healthchecks.io (periodo 5 min, gracia 10 min) y pega su URL de ping.
# Si el PC se apaga o pierde internet, te llega un email.
HEALTHCHECKS_PING_URL=
