# windows/1-instalar-firecrawl.ps1 crea .env a partir de este archivo y rellena lo que falta.

# Ruta secreta larga y aleatoria (el script la genera). Es tu "contraseña": quien la tenga puede usar tu Firecrawl.
MCP_SECRET_PATH=cambia-esto-por-algo-largo-y-aleatorio

# Tailscale: login.tailscale.com -> Settings -> Keys -> Generate auth key (Reusable, sin Ephemeral, sin tags).
TS_AUTHKEY=
TS_HOSTNAME=firecrawl

# Opcional: red de Docker del Firecrawl self-hosted (<proyecto>_backend) y URL de su API dentro de esa red.
# FIRECRAWL_NETWORK=firecrawl_backend
# FIRECRAWL_API_URL=http://api:3002
